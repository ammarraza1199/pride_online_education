rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Courses: Public can read, authenticated admin can manage
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Blogs: Public can read, authenticated admin can manage
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Student Enquiries / Contact queries: Public can create, authenticated admin can read/manage
    match /queries/{queryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
